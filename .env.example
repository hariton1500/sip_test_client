# Скопируйте в .env и заполните своими значениями.
# .env в git не попадает (см. .gitignore).

# --- Учётная запись на SIP-сервере / АТС ---
SIP_SERVER=192.168.1.10
SIP_PORT=5060
SIP_USER=1000
SIP_PASS=secret

# --- Сеть ---
# ВАЖНО: локальный IPv4-адрес этой машины в той же сети, что и АТС.
# Если оставить пустым, pyVoIP подставит 0.0.0.0 -> получите one-way audio.
SIP_MY_IP=192.168.1.50

# Порт, на котором слушаем SIP (UDP)
SIP_LOCAL_PORT=5060

# Диапазон RTP-портов (UDP). Должен быть открыт в брандмауэре Windows.
RTP_PORT_LOW=10000
RTP_PORT_HIGH=10100

# --- ASR/LLM/TTS (OpenAI-совместимый API, например AiTunnel) ---
# Нужны для живой расшифровки в веб-интерфейсе (`incoming --ui`).
OPENAI_BASE_URL=https://api.aitunnel.ru/v1
OPENAI_API_KEY=
ASR_MODEL=whisper-large-v3
ASR_LANGUAGE=ru
AI_TIMEOUT=30

# --- System prompt для LLM ---
# Файлы склеиваются в указанном порядке (запятая, точка с запятой или
# перевод строки). Пути можно указывать как prompts/name.md.
SYSTEM_PROMPT_FILES=support_evp.md,connection_terms.md,billing_account_data.md,internet_private.md

# Устаревший одиночный вариант. Используется, только если
# SYSTEM_PROMPT_FILES не задан или пуст.
# SYSTEM_PROMPT_FILE=prompts/support_evp.md
